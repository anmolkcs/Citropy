{
  "name": "citropy",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "A painted control surface for terminal coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinuxongit/Citropy.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server/main.ts --dev",
    "build": "vite build",
    "start": "vite build && node --experimental-strip-types server/main.ts",
    "serve": "node --experimental-strip-types server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "node --experimental-strip-types --test tests/ui/*.test.mjs",
    "desktop": "npm run build && node desktop/start.mjs",
    "setup:desktop": "node node_modules/electron/install.js",
    "desktop:dev": "node desktop/start.mjs --dev",
    "desktop:install": "node desktop/install.mjs",
    "desktop:package": "node desktop/package.mjs",
    "desktop:smoke": "node desktop/smoke.mjs",
    "desktop:smoke:mac": "node desktop/smoke-mac.mjs",
    "desktop:smoke:win": "node desktop/smoke-win.mjs",
    "screenshots": "node tests/screenshots.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "electron-updater": "6.8.9",
    "node-pty": "^1.0.0",
    "semver": "7.8.5",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/semver": "7.8.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.2.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.6",
    "monaco-editor": "^0.56.0",
    "motion": "^12.0.6",
    "perfect-freehand": "1.2.3",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.0.0",
    "shiki": "^1.26.1",
    "simplify-js": "1.2.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "node-pty@1.1.0": true
  },
  "main": "desktop/entry.mjs",
  "desktopName": "citropy.desktop",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.16"
    }
  }
}
